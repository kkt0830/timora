# Web and Native first login require these public build settings.
# Native restores an existing local identity offline without contacting Supabase.
# GitHub Actions uses Repository variables with the same names.
# Public Supabase project URL (PC setup; do not put secrets here).
VITE_SUPABASE_URL=
# Browser publishable key. Never use sb_secret_* or service_role keys.
VITE_SUPABASE_PUBLISHABLE_KEY=
